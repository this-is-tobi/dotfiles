{
  // visuals
  "telemetry.telemetryLevel": "off",
  "window.autoDetectColorScheme": true,
  "workbench.preferredLightColorTheme": "GitHub Light Default",
  "workbench.preferredDarkColorTheme": "GitHub Dark Default",
  "workbench.colorTheme": "GitHub Dark Default",
  "workbench.fontAliasing": "antialiased",
  "workbench.iconTheme": "material-icon-theme",
  "workbench.editor.showTabs": "multiple",
  "editor.fontFamily": "Input Mono, Fira Code, monospace",
  "editor.fontLigatures": "'ss01', 'ss02', 'ss03', 'ss06', 'zero'",
  "editor.cursorBlinking": "phase",
  "editor.suggestSelection": "first",
  "editor.wordWrap": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.tabSize": 2,
  "editor.minimap.enabled": false,
  "search.exclude": {
    "**/.git": true,
    "**/.nuxt": true,
    "**/.pnpm": true,
    "**/.vscode": true,
    "**/.yarn": true,
    "**/dist/**": true,
    "**/logs": true,
    "**/node_modules": true,
    "**/out/**": true,
    "**/package-lock.json": true,
    "**/bun.lock": true,
    "**/bun.lockb": true,
    "**/pnpm-lock.yaml": true,
    "**/yarn.lock": true
  },
  "terminal.integrated.fontFamily": "Hack Nerd Font Mono",
  "terminal.integrated.gpuAcceleration": "off",
  "terminal.integrated.enableImages": true,
  "terminal.integrated.enableKittyKeyboardProtocol": true,
  // general
  "editor.unicodeHighlight.invisibleCharacters": false,
  "workbench.startupEditor": "none",
  // git
  "git.autofetch": true,
  "git.untrackedChanges": "separate",
  "git.addAICoAuthor": "off",
  // github
  "githubPullRequests.pullBranch": "never",
  // eslint
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "never"
  },
  "eslint.format.enable": true,
  "eslint.quiet": true,
  "eslint.validate": [
    "javascript",
    "typescript",
    "javascriptreact",
    "typescriptreact",
    "vue",
    "html",
    "markdown",
    "json",
    "jsonc",
    "json5"
  ],
  // projects without an eslint config of their own fall back to
  // ~/eslint.config.mjs, which ESLint finds by itself when looking up from the
  // linted file (a project's own config always comes first); nodePath provides
  // eslint to projects that do not install it. __HOME__ is substituted for the
  // real home directory by the setup scripts.
  "eslint.workingDirectories": [{ "mode": "auto" }],
  "eslint.nodePath": "__HOME__/.config/eslint-fallback/node_modules",
  // stylelint
  "css.validate": false,
  "less.validate": true,
  "scss.validate": true,
  "files.associations": {
    "*.css": "postcss",
    "*.hcl": "terraform"
  },
  // languages
  "[typescript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "js/ts.preferences.quoteStyle": "single",
  "js/ts.preferences.importModuleSpecifierEnding": "auto",
  "js/ts.preferences.preferTypeOnlyAutoImports": true,
  "js/ts.suggest.jsdoc.enabled": true,
  "js/ts.suggest.jsdoc.generateReturns": true,
  "js/ts.inlayHints.parameterNames.enabled": "literals",
  "js/ts.inlayHints.parameterTypes.enabled": false,
  "js/ts.inlayHints.variableTypes.enabled": false,
  "js/ts.inlayHints.functionLikeReturnTypes.enabled": true,
  "js/ts.inlayHints.enumMemberValues.enabled": true,
  "[javascript]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[html]": {
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  "[markdown]": {
    "editor.quickSuggestions": {
      "other": true,
      "comments": true,
      "strings": true
    },
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.defaultFormatter": "yzhang.markdown-all-in-one"
  },
  "[terraform]": {
    "editor.defaultFormatter": "hashicorp.terraform",
    "editor.formatOnSave": true
  },
  // yaml — disable validation globally, re-enable only for plain yaml files
  // (prevents Red Hat YAML extension from validating Helm templates)
  "yaml.validate": false,
  "yaml.schemas": {
    "https://json.schemastore.org/chart.json": "**/helm/Chart.yaml"
  },
  "redhat.telemetry.enabled": false,
  "sonarlint.disableTelemetry": true,
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[helm-template]": {
    "editor.formatOnSave": false
  },
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "go.toolsManagement.autoUpdate": true,
  // conventional commits
  "conventionalCommits.showNewVersionNotes": false,
  // kubernetes
  "vs-kubernetes": {
    "vs-kubernetes.crd-code-completion": "enabled"
  },
  "vscode-kubernetes.log-viewer.follow": true,
  "vscode-kubernetes.log-viewer.timestamp": false,
  "vscode-kubernetes.log-viewer.since": -1,
  "vscode-kubernetes.log-viewer.tail": -1,
  "vscode-kubernetes.log-viewer.destination": "Webview",
  "vscode-kubernetes.log-viewer.wrap": true,
  // markdown preview
  "markdown-preview-enhanced.previewTheme": "github-dark.css",
  "markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
  "markdown-preview-enhanced.enablePreviewZenMode": false,
  // extensions
  "database-client.autoSync": true,
  "docker.extension.enableComposeLanguageServer": false,
  "diffEditor.ignoreTrimWhitespace": false,
  "gitlens.ai.model": "vscode",
  "claudeCode.preferredLocation": "sidebar",
  "claudeCode.hideOnboarding": true,
  // copilot
  "github.copilot.chat.agent.autoFix": true,
  "github.copilot.chat.reviewAgent.enabled": true,
  "github.copilot.chat.languageContext.fix.typescript.enabled": true,
  "github.copilot.chat.languageContext.inline.typescript.enabled": true,
  "github.copilot.chat.languageContext.typescript.enabled": true,
  "github.copilot.editor.enableCodeActions": false,
  "github.copilot.nextEditSuggestions.enabled": true,
  "github.copilot.enable": {
    "*": true,
    "markdown": true,
    "plaintext": false,
    "scminput": false
  },
  // The chat.*Locations settings below add folders to the ones each agent already reads
  // (the Local agent reads only the folders listed here). Glob patterns in them are
  // deprecated, plain folder paths are fine.
  // instructions — ~/.copilot/instructions/ loaded in every repo
  "chat.instructionsFilesLocations": {
    ".github/instructions": true,
    "~/.copilot/instructions": true
  },
  "chat.includeApplyingInstructions": true,
  "chat.useAgentsMdFile": true,
  "chat.useClaudeMdFile": true,
  // per-feature instructions: commit, PR, review
  // note: ~ expansion requires VS Code to support it; use full path if not working
  "github.copilot.chat.commitMessageGeneration.instructions": [
    { "file": "~/.copilot/instructions/commit-message.instructions.md" }
  ],
  "github.copilot.chat.pullRequestDescriptionGeneration.instructions": [
    { "file": "~/.copilot/instructions/pull-request.instructions.md" }
  ],
  "github.copilot.chat.reviewSelection.instructions": [
    { "file": "~/.copilot/instructions/code-review.instructions.md" }
  ],
  // skills — personal ~/.copilot/skills/ and ~/.claude/skills/ enabled by default
  "chat.useAgentSkills": true,
  "chat.agentSkillsLocations": {
    ".github/skills": true,
    ".claude/skills": true,
    "~/.copilot/skills": true,
    "~/.claude/skills": true
  },
  "chat.useHooks": true,
  "chat.useClaudeHooks": true,
  "chat.hookFilesLocations": {
    "~/.copilot/hooks": true
  },
  // agents
  "chat.agentFilesLocations": {
    ".github/agents": true,
    "~/.copilot/agents": true
  },
  "github.copilot.chat.backgroundAgent.enabled": true,
  "chat.agent.maxRequests": 100,
  // security: terminal commands the agent runs go through an OS sandbox (macOS and
  // Linux; the default is off). The approval rules below only look at the command text,
  // and aliases, quote concatenation or subshells can slip past them: the sandbox is
  // the boundary, the rules are a convenience. A command the sandbox blocks can still
  // be run outside it after confirmation (chat.agent.sandbox.allowUnsandboxedCommands).
  "chat.agent.sandbox.enabled": "on",
  "chat.tools.edits.autoApprove": {
    "**/*": true,
    "**/.vscode/*.json": false,
    "**/.git/**": false,
    "**/{package.json,package-lock.json,server.xml,build.rs,web.config,.gitattributes,.env}": false,
    "**/.env*": false,
    "**/*.{csproj,fsproj,vbproj}": false,
    // anything that runs by itself later, or steers the next agent session
    "**/.github/workflows/**": false,
    "**/.github/{actions,instructions,agents,skills,hooks}/**": false,
    "**/.github/copilot-instructions.md": false,
    "**/{AGENTS.md,CLAUDE.md}": false,
    "**/.claude/**": false,
    "**/.husky/**": false,
    "**/.devcontainer/**": false,
    "**/{.mcp.json,.envrc,mise.toml,.mise.toml,.pre-commit-config.yaml,lefthook.yml}": false,
    // keys and secrets
    "**/*.{pem,key,p12,pfx}": false,
    "**/secrets/**": false
  },
  // Terminal commands the agent runs without asking, on top of VS Code's built-in rules
  // (read-only commands such as ls, cat, grep, find, sed, and read-only git, docker, npm,
  // yarn and pnpm subcommands run by themselves; rm, curl, wget, chmod, chown and jq need
  // approval). A false rule always wins. Allow what is read-only, and name what a command
  // can reach (the environment, files with secrets), not only what it is called.
  "chat.tools.terminal.autoApprove": {
    // ── filesystem / info ─────────────────────────────────────────────────
    "type": true,
    "diff": true,
    "lsof": true,
    "uname": true,
    "hostname": true,
    "whoami": true,
    "id": true,
    "uptime": true,
    "timeout": false, // runs any command it is given
    // ── text processing ───────────────────────────────────────────────────
    "awk": true,
    "/^awk\\b.*(system|getline|ENVIRON|\\s-f\\b|--file|@include|@load|\\||>>)/": false, // no shell, file reads, environment or pipes from inside awk
    "/^sed\\b.*-i\\b/": false, // block in-place edits
    "jq": true,
    "/^jq\\b.*(\\$ENV|\\benv\\b|--rawfile|--slurpfile|--argfile|\\s-f\\b|--from-file|input_filename)/": false, // no environment or file reads
    "yq": true,
    "/^yq\\b.*(\\benv\\(|strenv\\(|\\bload\\(|load_str\\(|\\s-i\\b|--inplace|--from-file)/": false, // no environment, file loads or in-place edits
    "sort": true,
    "/^sort\\b.*-(o|S)\\b/": false,
    // ── search / find ─────────────────────────────────────────────────────
    "/^find\\b.*-(delete|exec|execdir|fprint|fprintf|fls|ok|okdir)\\b/": false,
    "/^grep\\b.*-(f|P)\\b/": false,
    // ── network read-only ─────────────────────────────────────────────────
    "ping": true,
    "dig": true,
    "nslookup": true,
    "host": true,
    "netstat": true,
    "ss": true,
    // ── git (read-only) ───────────────────────────────────────────────────
    "git status": true,
    "git log": true,
    "git show": true,
    "git diff": true,
    // ── kubernetes: read-only verbs, secret values are never printed ─────
    "/^kubectl\\s+(get|describe|logs|top|explain|api-resources|api-versions|version|cluster-info|events|diff|auth\\s+can-i|config\\s+(view|get-contexts|current-context)|rollout\\s+(status|history))\\b/": true,
    "/^kubectl\\b(?=.*\\bsecrets?\\b)(?=.*(\\s-o\\s*(yaml|json|jsonpath|go-template|template)|--output[= ]\\s*(yaml|json|jsonpath|go-template|template)))/": false,
    "/^kubectl\\b.*\\s--raw\\b/": false,
    // ── helm: query and template only (helm get values can print secrets) ─
    "/^helm\\s+(list|ls|status|history|search|show|template|lint|version|env|repo\\s+list|get\\s+(notes|metadata))\\b/": true,
    // ── go: build, test and inspect (go run, get and install ask) ─────────
    "/^go\\s+(version|env|list|vet|fmt|build|test|doc|mod\\s+(graph|why|verify))\\b/": true,
    // ── linters ───────────────────────────────────────────────────────────
    "yamllint": true,
    // ── shell injection guards ────────────────────────────────────────────
    "/\\(.+\\)/": { "approve": false, "matchCommandLine": true },
    "/\\{.+\\}/": { "approve": false, "matchCommandLine": true },
    "/`.+`/": { "approve": false, "matchCommandLine": true },
    // ── secrets: a command that names a secret file or variable asks first ─
    "/(^|[\\s/=\\'\"])\\.(env(\\.\\S+)?|netrc|npmrc|pypirc|git-credentials|vault-token)([\\s\\'\"]|$)/": { "approve": false, "matchCommandLine": true },
    "/(^|[\\s/=\\'\"])(\\.ssh|\\.aws|\\.gnupg|\\.kube|\\.docker/config\\.json|\\.config/gh/hosts\\.yml|secrets\\.env|id_(rsa|dsa|ecdsa|ed25519)|[^\\s/\\'\"]+\\.(pem|key|p12|pfx))([/\\s\\'\"]|$)/": { "approve": false, "matchCommandLine": true },
    "/\\$\\{?[A-Za-z0-9_]*(TOKEN|SECRET|PASSWORD|PASSWD|API_?KEY|CREDENTIAL|PRIVATE_?KEY)/i": { "approve": false, "matchCommandLine": true },
    // ── always blocked: destructive / remote access / privilege ───────────
    "rm": false,
    "del": false,
    "dd": false,
    "erase": false,
    "kill": false,
    "ps": false,
    "top": false,
    // remote access — never auto-approve
    "ssh": false,
    "scp": false,
    "sftp": false,
    "rsync": false,
    "nc": false,
    "ncat": false,
    "netcat": false,
    "socat": false,
    "mosh": false,
    // network write
    "curl": false,
    "wget": false,
    // privilege / ownership changes
    "chmod": false,
    "chown": false,
    "sudo": false,
    "su": false,
    // code execution / injection
    "eval": false,
    "xargs": false
  },
  "chat.tools.global.autoApprove": false,
  "chat.mcp.autostart": "newAndOutdated",
  "chat.mcp.gallery.enabled": true,
  "chat.mcp.serverSampling": {},
  "chat.tools.urls.autoApprove": {
    "https://artifacthub.io": true
  },
  "chat.viewSessions.orientation": "stacked"
}

# Local secrets for this machine, loaded into every zsh session by env.sh.
#
# The setup copies this template to ~/.config/dotfiles/secrets.env once (mode
# 600) and never overwrites that file. Keep it private and out of version
# control. Uncomment and fill in only what you use.
#
# Format: plain KEY=value, no spaces around "=". Wrap values containing spaces
# or shell characters ($ ` ! # ;) in single quotes: KEY='va$ue'.
#
# Everything here is visible to every program started from your shell,
# including AI agents. Keep per-project secrets in that project's .env.local
# and load them with direnv (`dotenv_if_exists .env.local` in .envrc).

# Context7 documentation MCP server (https://context7.com)
# CONTEXT7_API_KEY=

# ArgoCD: the MCP server (registered when ARGOCD_BASE_URL is set) and the CLI
# ARGOCD_BASE_URL=https://argocd.example.com
# ARGOCD_API_TOKEN=
# ARGOCD_AUTH_TOKEN=

# HashiCorp Vault CLI
# VAULT_ADDR=https://vault.example.com
# VAULT_TOKEN=

# Raises the GitHub API rate limit mise hits when downloading tools
# MISE_GITHUB_TOKEN=

# Behind a proxy that blocks mise.jdx.dev: list versions from GitHub, and send no download report
# MISE_USE_VERSIONS_HOST=0
# MISE_USE_VERSIONS_HOST_TRACK=0

# Optional: keys kept in an rta store (https://github.com/this-is-tobi/rta) instead of this
# file. Names only, no values: the `secrets` command exports them into the shell.
# DOTFILES_RTA_KEYS="CONTEXT7_API_KEY ARGOCD_API_TOKEN"
